name: Build Custom Ntfy APK

on:
  workflow_dispatch:
    inputs:
      topic_name:
        description: '请输入你要打包的校区主题名 (例如: sc_137)'
        required: true
        default: 'sc_'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Java JDK
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Inject Dynamic Topic
        run: |
          sed -i "s/BUILD_TIME_TOPIC_PLACEHOLDER/${{ github.event.inputs.topic_name }}/g" app/src/main/java/io/heckel/ntfy/ui/MainActivity.kt

      - name: Grant execute permission for gradlew
        run: chmod +x gradlew

      # 👇 修改点 1：使用官方正确的无谷歌服务版本编译任务：assembleFdroidRelease
      - name: Build APK (F-Droid Release)
        run: ./gradlew assembleFdroidRelease

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: rider_apk_${{ github.event.inputs.topic_name }}
          # 👇 修改点 2：导出路径也对应修改为 fdroid 文件夹
          path: app/build/outputs/apk/fdroid/release/*-unsigned.apk
