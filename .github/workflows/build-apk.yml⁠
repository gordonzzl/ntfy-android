name: Build Custom Ntfy APK

on:
  workflow_dispatch:
    inputs:
      topic_name:
        description: '请输入你要打包的校区主题名 (例如: school_suzhou 或 school_kunshan)'
        required: true
        default: 'school_suzhou'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Java JDK
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Inject Dynamic Topic
        # 核心逻辑：在编译前，把 Kotlin 代码里的占位符替换成你输入的参数
        run: |
          sed -i "s/BUILD_TIME_TOPIC_PLACEHOLDER/${{ github.event.inputs.topic_name }}/g" app/src/main/java/io/heckel/ntfy/ui/MainActivity.kt

      - name: Grant execute permission for gradlew
        run: chmod +x gradlew

      - name: Build APK (PlayNoGoogle Release)
        run: ./gradlew assemblePlayNoGoogleRelease

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          # 打包出来的压缩包名字也会带上主题名，方便你区分不同校区的包！
          name: rider_apk_${{ github.event.inputs.topic_name }}
          path: app/build/outputs/apk/playNoGoogle/release/*-unsigned.apk
